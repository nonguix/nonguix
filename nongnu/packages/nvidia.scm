                       (string-append "SYSSRC=" (search-input-directory
                                                 inputs "/lib/modules/build"))
                       `(,@(if parallel-build?
                               `("-j" ,(number->string
                                        (parallel-job-count)))
                               '())
                         ,@make-flags)))))))

