;; nvidia-detect
;; Inspired by https://github.com/elrepo/packages/tree/25ccc731f5db71c84cf0a7989693531e984b6bfe/nvidia-detect/nvidia-detect-595.104.02

(define nvidia-detect-script
  (program-file "nvidia-detect"
    (with-imported-modules
        (source-module-closure
         '((gnu build linux-modules)
           (gnu installer hardware)))
      #~(begin
          (use-modules (ice-9 format)
                       (gnu build linux-modules)
                       (gnu installer hardware))

          (define get-description
            (pci-device-description
             #$(file-append pciutils "/share/hwdata/pci.ids.gz")))

          (define (nvidia-drivers id)
            (append
             (if (memq id '#$%nvidia-595-supported-gpus)
                 '(nvda-595)
                 '())
             (if (memq id '#$%nvidia-580-supported-gpus)
                 '(nvda-580)
                 '())
             (if (memq id '#$%nvidia-470-supported-gpus)
                 '(nvda-470)
                 '())
             (if (memq id '#$%nvidia-390-supported-gpus)
                 '(nvda-390)
                 '())))

          (define nvidia-devices
            (filter (lambda (x)
                      (eq? (pci-device-vendor x) #x10de))
                    (pci-devices)))

          (for-each (lambda (device)
                      (let ((drivers (nvidia-drivers (pci-device-id device))))
                        (unless (null? drivers)
                          (format #t "[~x:~x] ~a:~{ ~a~}~%"
                                  (pci-device-vendor device)
                                  (pci-device-id device)
                                  (get-description device)
                                  drivers))))
                    nvidia-devices)))))

(define-public nvidia-detect
  (package
    (name "nvidia-detect")
    (version "0.0.0")
    (source nvidia-detect-script)       ;for `guix build --source'
    (build-system trivial-build-system)
    (arguments
     (list #:builder
           (with-imported-modules '((guix build utils))
             #~(begin
                 (use-modules (guix build utils))
                 (let ((dest (string-append #$output "/bin/nvidia-detect")))
                   (mkdir-p (dirname dest))
                   (copy-file #$nvidia-detect-script dest))))))
    (home-page "https://nonguix.org/")
    (synopsis "Detect NVIDIA graphics cards")
    (description
     "@command{nvidia-detect} detects NVIDIA graphics cards on the current
system and outputs their supported drivers.")
    (license license-gnu:gpl3+)))


